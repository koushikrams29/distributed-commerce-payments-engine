# Template for infra/.env on a public server. scripts/deploy/create_env.sh fills
# it in with freshly generated secrets; edit by hand only if you know why.
# Secrets must be hex (no symbols): they are embedded in connection URLs.

# The domain name that points at this server, e.g. my-shop.duckdns.org.
SITE_ADDRESS=

POSTGRES_USER=commerce
POSTGRES_PASSWORD=
POSTGRES_DB=order_service

RABBITMQ_USER=commerce
RABBITMQ_PASSWORD=

JWT_SECRET=

# The demo accounts (admin@example.com, shopper@example.com). Applied when the
# accounts are first created, so set them before the first start.
DEMO_ADMIN_PASSWORD=
DEMO_SHOPPER_PASSWORD=

# Grafana's "admin" user; dashboards stay readable without logging in.
GRAFANA_ADMIN_PASSWORD=
