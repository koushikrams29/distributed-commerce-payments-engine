# Leave both empty in development: the Vite dev server proxies /api and /ws
# to the gateway (override its address with GATEWAY_URL when starting Vite).
# Set them when the built dashboard is hosted on a different origin than the
# gateway, and add that origin to the gateway's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
VITE_WS_URL=
