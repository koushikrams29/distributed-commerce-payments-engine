# ${GATEWAY_URL}, ${NGINX_LOCAL_RESOLVERS} and ${TRUSTED_PROXY} are filled in at
# container start. nginx's own variables ($host, $remote_addr, ...) are left
# alone because no environment variable has those names.

# Re-resolve the gateway's name instead of caching one address forever: a
# restarted gateway container comes back with a new IP.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

# Behind a TLS proxy, $remote_addr would be the proxy for every visitor, so take
# the client from the X-Forwarded-For it sets — but only from that proxy's
# addresses. The default (loopback) trusts no real client.
set_real_ip_from ${TRUSTED_PROXY};
real_ip_header X-Forwarded-For;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # A variable in proxy_pass makes nginx resolve per request (through the
    # resolver above) and lets it start before the gateway is reachable.
    # GATEWAY_URL must have no path, not even a trailing slash: with a path,
    # nginx would send every request to that path instead of the original URI.
    set $gateway ${GATEWAY_URL};

    location /api/ {
        proxy_pass $gateway;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        # Overwritten, never appended: the gateway's rate limiter trusts this
        # header, so a value sent by the client must not survive.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass $gateway;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Dashboard sockets sit idle between events; the default 60s would cut them.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Vite fingerprints asset file names, so a changed file always gets a new URL.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        # index.html names the current asset files, so it must be revalidated.
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
