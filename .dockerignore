# Service images build from the repository root (they need libs/common), so
# everything here would otherwise be sent to the Docker daemon on every build.
.git
.github
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/*.egg-info
**/.pytest_cache
**/.env
**/.env.*
!**/.env.example
**/tests
docs
infra
frontend
scripts
