DATABASE_URL=postgresql+psycopg2://commerce:commerce_dev_password@localhost:5432/payment_service
JWT_SECRET=dev-only-change-me-gateway-jwt-secret
MOCK_PAYMENT_OUTCOME=success
# Used only when MOCK_PAYMENT_OUTCOME=timeout. Reconciliation queries this
# deterministic provider result; it never submits the charge again.
MOCK_PAYMENT_TIMEOUT_RESOLUTION=unknown
MOCK_PAYMENT_LATENCY_SECONDS=0
PAYMENT_RECONCILE_ENABLED=true
PAYMENT_RECONCILE_AFTER_SECONDS=30
PAYMENT_RECONCILE_POLL_INTERVAL_SECONDS=10
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
USE_EVENT_BUS=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRACE_SAMPLE_RATIO=1.0
LOG_FORMAT=text
LOG_LEVEL=INFO
